{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openkedge.github.io/hardknock/schemas/integration-manifest-v1.schema.json",
  "title": "Hardknock Generic Agent Integration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_version",
    "package",
    "stability",
    "runtime",
    "transport",
    "tools",
    "capabilities",
    "security",
    "support"
  ],
  "properties": {
    "schema": {
      "const": "https://openkedge.github.io/hardknock/schemas/integration-manifest-v1.schema.json"
    },
    "manifest_version": {
      "const": "1.0.0"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "hardknock" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "stability": {
      "enum": ["experimental", "preview", "stable"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "required_environment", "healthcheck"],
      "properties": {
        "command": { "const": "hardknock" },
        "args": {
          "const": ["mcp", "serve", "--stdio"]
        },
        "required_environment": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "secret"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "secret": { "const": false }
            }
          }
        },
        "healthcheck": { "$ref": "#/$defs/command" }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol", "protocol_version"],
      "properties": {
        "kind": { "const": "stdio" },
        "protocol": { "const": "mcp" },
        "protocol_version": { "const": "2026-07-28" }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/tool" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/capability" }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_bridge_only", "exclusions"],
      "properties": {
        "local_bridge_only": { "const": true },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "allOf": [
            {
              "contains": { "const": "agent_execution" }
            },
            {
              "contains": { "const": "approval_grant" }
            },
            {
              "contains": { "const": "experiment_creation" }
            },
            {
              "contains": { "const": "external_effect_commit" }
            },
            {
              "contains": { "const": "unrestricted_command_execution" }
            },
            {
              "contains": { "const": "unrestricted_filesystem_access" }
            }
          ],
          "items": {
            "enum": [
              "agent_execution",
              "approval_grant",
              "experiment_creation",
              "external_effect_commit",
              "unrestricted_command_execution",
              "unrestricted_filesystem_access"
            ]
          }
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_systems", "architectures"],
      "properties": {
        "operating_systems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["linux", "macos"] }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["aarch64", "x86_64"] }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "timeout_seconds"],
      "properties": {
        "command": { "const": "hardknock" },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "capability", "effect"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^hardknock_[a-z0-9_]{1,63}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{1,63}$",
          "not": {
            "enum": [
              "agent_execution",
              "approval_grant",
              "experiment_creation",
              "external_effect_commit",
              "unrestricted_command_execution",
              "unrestricted_filesystem_access"
            ]
          }
        },
        "effect": {
          "enum": [
            "read_only",
            "records_evidence"
          ]
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{1,63}$",
          "not": {
            "enum": [
              "agent_execution",
              "approval_grant",
              "experiment_creation",
              "external_effect_commit",
              "unrestricted_command_execution",
              "unrestricted_filesystem_access"
            ]
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
